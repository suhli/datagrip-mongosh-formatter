{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "runIde (debug)",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "args": [
        "runIde",
        "-PdebugIde=true",
        "--console=plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "${env:JAVA_HOME}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "runIde",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Listening for transport dt_socket at address: 5005"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
